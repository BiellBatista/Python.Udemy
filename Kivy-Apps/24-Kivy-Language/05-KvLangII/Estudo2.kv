#criando uma nova classe (MeuBotao) que herda da classe Button
<MeuBotao@Button>:
    text: "Botao"

<Tela@BoxLayout>:  # criando a raiz, com o gerenciador de layout
    orientation: "horizontal"

    MeuBotao:
    MeuBotao:
    MeuBotao:

BoxLayout:
    Tela:
    Tela:
        orientation: "vertical"